# ===== Google Cloud & LLM Configuration =====
# GCP Project Configuration
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini Model Configuration
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# ===== API Keys =====
PERPLEXITY_API_KEY=your-perplexity-api-key
# GEMINI_API_KEY=your-gemini-api-key  # If using direct API instead of Vertex AI

# ===== Perplexity Configuration =====
PERPLEXITY_MODEL=llama-3.1-sonar-large-128k-online
PERPLEXITY_TEMPERATURE=0.2
PERPLEXITY_MAX_TOKENS=1024
PERPLEXITY_TOP_P=0.9
PERPLEXITY_FREQUENCY_PENALTY=1
PERPLEXITY_PRESENCE_PENALTY=0

# ===== Memory (Mem0) Configuration =====
MEM0_BASE_URL=https://mem0-server-sbizyecxta-el.a.run.app
MEM0_API_KEY=  # Add if authentication is required
MEMORY_CACHE_TTL=300  # Cache timeout in seconds
MEMORY_SEARCH_LIMIT=10  # Default search result limit

# ===== Fi MCP Configuration =====
FI_MCP_BASE_URL=https://idx-fi-mcp-dev-94592976-554022930653.asia-south1.run.app
FI_MCP_PHONE_NUMBER=2222222222
FI_MCP_TIMEOUT=30  # Request timeout in seconds

# ===== Agent Configuration =====
# Orchestrator Settings
ORCHESTRATOR_TIMEOUT=300  # Overall query timeout in seconds
ORCHESTRATOR_MAX_RETRIES=3
AGENT_PARALLEL_EXECUTION=true  # Enable parallel agent execution
AGENT_DEFAULT_TIMEOUT=60  # Individual agent timeout

# Agent Temperature Settings (can override global)
FINANCIAL_AGENT_TEMPERATURE=0.5  # More deterministic for financial data
MARKET_AGENT_TEMPERATURE=0.7
ADVISORY_AGENT_TEMPERATURE=0.8  # More creative for advice

# ===== Application Configuration =====
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DEBUG_MODE=false
ENVIRONMENT=development  # development, staging, production

# ===== Streaming Configuration =====
STREAMING_ENABLED=true
STREAMING_CHUNK_SIZE=1024
SSE_KEEPALIVE_INTERVAL=30  # Seconds

# ===== Security Configuration =====
ENABLE_CORS=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
API_RATE_LIMIT=100  # Requests per minute
API_RATE_LIMIT_WINDOW=60  # Window in seconds

# ===== Feature Flags =====
ENABLE_MEMORY_PERSISTENCE=true
ENABLE_PATTERN_DETECTION=true
ENABLE_MARKET_RESEARCH=true
ENABLE_ADVISORY_RECOMMENDATIONS=true
ENABLE_TOOL_TRACKING=true

# ===== Database Configuration (if needed later) =====
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_ai
# REDIS_URL=redis://localhost:6379

# ===== Monitoring & Analytics =====
# SENTRY_DSN=your-sentry-dsn
# ANALYTICS_ENABLED=false
# METRICS_EXPORT_INTERVAL=60
